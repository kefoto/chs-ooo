      "chars": 59,
      "source": "manual_web_ui",
      "relabelled_at": "2026-08-14T15:26:42"
    },
    "level_complete_1": {
      "text_sha1": "3f445db386c0a20c94e06ee6d8f288445e50ea7d",
      "text": "Room finished! Thank you, these are for your book.",
