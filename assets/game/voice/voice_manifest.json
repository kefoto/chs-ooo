      "chars": 42,
      "source": "manual_web_ui",
      "relabelled_at": "2026-08-14T15:26:42"
    },
    "level_complete_0": {
      "text_sha1": "0fc85aa9ba4d39322149c5c9834b252493bd0c31",
      "text": "That's a whole room done! Thank you, here's what you found.",
