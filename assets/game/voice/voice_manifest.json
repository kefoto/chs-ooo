    "cutscene_open_1": {
      "text_sha1": "8dd88f2c1775e1f505b3d7f5b93cd3a5c6249e5f",
      "text": "Oh, hello! I'm Pip, and this is my castle.",
      "file": "voice/cutscene_open_1.wav",
      "chars": 42,
      "source": "manual_web_ui",
      "relabelled_at": "2026-08-14T15:26:42"
    },
    "cutscene_open_2": {
      "text_sha1": "0e553e2ed5399903da3a796cd962f3f5fa91230f",
      "text": "I can't decide what goes where! Will you help me sort things, room by room?",
      "file": "voice/cutscene_open_2.wav",
      "chars": 75,
      "source": "manual_web_ui",
      "relabelled_at": "2026-08-14T15:26:42"
    },
    "cutscene_close_0": {
      "text_sha1": "5c78ae319a3d40317b51685905e2190b71ba98aa",
      "text": "Look at that, every single room has something in it now.",
      "file": "voice/cutscene_close_0.wav",
      "chars": 56,
      "source": "manual_web_ui",
      "relabelled_at": "2026-08-14T15:26:42"
    },
    "cutscene_close_1": {
      "text_sha1": "59285a1de08c483e9b53f03a7f2e12a180072778",
      "text": "Thank you for showing me how you would sort things.",
      "file": "voice/cutscene_close_1.wav",
      "chars": 51,
      "source": "manual_web_ui",
      "relabelled_at": "2026-08-14T15:26:42"
    },
    "instructions_tier1_0": {
      "text_sha1": "c547715397d5aa445ff2f7d97dd1449399f8d848",
      "text": "In each room I'll show you three pictures.",
